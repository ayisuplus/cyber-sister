# Copy to a private absolute path outside the repository. Never commit the real file.
APP_ENV=internal
NODE_ENV=production
PORT=3000

POSTGRES_DB=cyber_sister
POSTGRES_USER=cyber_sister
POSTGRES_PASSWORD_FILE=/absolute/private/secrets/postgres_password
DATABASE_PASSWORD_FILE=/absolute/private/secrets/database_password
JWT_SECRET_FILE=/absolute/private/secrets/jwt_secret
JWT_REFRESH_SECRET_FILE=/absolute/private/secrets/jwt_refresh_secret
INTERNAL_TEST_PHONES_FILE=/absolute/private/secrets/internal_test_phones
INSTANCE_ADMIN_PHONES_FILE=/absolute/private/secrets/instance_admin_phones
INTERNAL_TEST_CODE_FILE=/absolute/private/secrets/internal_test_code

CORS_ORIGIN=https://internal.example.test
COOKIE_SECURE=true
APP_DOMAIN=internal.example.test
BIND_ADDRESS=replace-with-vpn-or-private-interface-ip
IMAGE_TAG=replace-with-immutable-release-tag


# Total provider-candidate budget. Downstream bridge/proxy/browser timeouts are deliberately larger.
GATEWAY_REQUEST_TIMEOUT=60000

# Cloud provider slot (provider-neutral, any OpenAI-compatible endpoint).
# 2026-09-07 云端切割后这是聊天的唯一模型路径：三件套必须同时配置，
# 否则聊天与解释返回 LLM_UNAVAILABLE。同意门版本 cloud-primary-v1。
# GATEWAY_QWEN_BASE_URL=replace-with-approved-openai-compatible-base-url
# GATEWAY_QWEN_MODEL=replace-with-approved-model
# GATEWAY_QWEN_API_KEY_FILE=/absolute/private/secrets/qwen_api_key
# GATEWAY_QWEN_SCENES=chat,explain

# SEARCH_ENABLED=false（默认关闭；开启后聊天/工作模式可用 web_search 联网搜索，
# 经普通 HTTP 请求 DuckDuckGo，不驱动浏览器）
# 语音转文字（本机 FunASR sidecar，tools/asr-server，模型 iic/SenseVoiceSmall 来自 ModelScope）：不配置 ASR_BASE_URL 则语音输入诚实报不可用
# ASR_BASE_URL=http://127.0.0.1:5005
# Leave unset until the product owner has verified the official sources and date.
# CRISIS_RESOURCES_JSON=[{"type":"...","label":"...","guidance":"..."}]

TLS_CERT_PATH=/absolute/path/to/tls.crt
TLS_KEY_PATH=/absolute/path/to/tls.key
