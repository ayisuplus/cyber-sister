# 妆语 / AI Makeup Tutor — 环境变量示例
# 复制为 .env 后按需修改;未填写的项会 fallback 到 config.ts 中的默认值.

# ---------- Server ----------
PORT=3001
# 单域名可用 CORS_ORIGIN；多域名用逗号分隔的 CORS_ORIGINS（后者优先）
CORS_ORIGIN=
CORS_ORIGINS=
NODE_ENV=development
# 仅服务端使用：主应用 API，负责认证、本地优先模型路由与外部备用授权
MAIN_API_INTERNAL_URL=http://localhost:3000

# ---------- Rate limits (per minute per IP) ----------
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_ANALYTICS=60

# ---------- Static assets ----------
STATIC_MAX_AGE_SEC=3600
