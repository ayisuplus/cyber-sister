{
  "name": "cyber-sister",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "pnpm --filter cyber-sister-server dev",
    "dev:web": "pnpm --filter cyber-sister-client dev",
    "build": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" build",
    "test": "pnpm -r test",
    "test:deploy": "node --test deploy/scripts/release.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "engines": {
    "node": ">=24"
  }
}
