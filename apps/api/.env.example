# 赛博姐妹后端环境变量配置

# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置（开发环境：先启动 docker-compose up postgres，或本地安装 PostgreSQL）
DATABASE_URL="postgresql://cyber_sister:cyber_sister_dev@localhost:5432/cyber_sister"

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Mock 验证码（仅开发环境生效，生产环境设置此项会触发警告）
# MOCK_VERIFICATION_CODE=888888

# Redis配置（可选，生产环境推荐）
# REDIS_URL=redis://localhost:6379

# LLM服务配置（可选，不配置则使用 Mock 回复）
LLM_API_URL=http://localhost:8000/v1/chat/completions
LLM_MODEL=cyber-sister-qwen3-8b
LLM_API_KEY=

# 日志配置
LOG_LEVEL=info

# CORS配置
CORS_ORIGIN=http://localhost:5173
