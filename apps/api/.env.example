# 赛博姐妹 API — local development example only. Never commit real values.
APP_ENV=development
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://cyber_sister:cyber_sister_dev@localhost:5432/cyber_sister
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

# Internal-test runtime. Production-like internal runs require repository-external
# secret files; fixed codes are rejected whenever APP_ENV is not internal.
# APP_ENV=internal
# DATABASE_PASSWORD_FILE=/absolute/private/secrets/postgres_password
# JWT_SECRET_FILE=/absolute/private/secrets/jwt_secret
# JWT_REFRESH_SECRET_FILE=/absolute/private/secrets/jwt_refresh_secret
# INTERNAL_TEST_PHONES_FILE=/absolute/private/secrets/internal_test_phones
# INSTANCE_ADMIN_PHONES_FILE=/absolute/private/secrets/instance_admin_phones
# INTERNAL_TEST_CODE_FILE=/absolute/private/secrets/internal_test_code
# APP_DOMAIN=internal.example.test

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Qwen through its OpenAI-compatible endpoint. The exact approved model is
# environment configuration and is intentionally not hard-coded.
# GATEWAY_PROVIDERS=qwen
# GATEWAY_REGION=CN
# GATEWAY_QWEN_BASE_URL=replace-with-approved-openai-compatible-base-url
# GATEWAY_QWEN_MODEL=replace-with-approved-qwen-model
# 聊天照片点评走同一模型槽：GATEWAY_QWEN_MODEL 须指向视觉模型（如 qwen-vl 系列）；
# 供应商不支持图片时图片消息诚实 LLM_UNAVAILABLE，纯文本聊天不受影响。
# GATEWAY_QWEN_API_KEY_FILE=/absolute/private/secrets/qwen_api_key
# GATEWAY_QWEN_REGIONS=CN
# GATEWAY_QWEN_SCENES=chat,explain
# GATEWAY_SCENE_chat=qwen
# GATEWAY_SCENE_explain=qwen
# GATEWAY_REQUEST_TIMEOUT=25000

# 自定义模型供应商（设置页 →「模型供应商」，只有实例管理员看得见）：配了就用库里的，
# 一家都没配时上面的 GATEWAY_QWEN_* 槽仍然生效。
# 这一项不是密钥本身，而是「放主密钥的只读文件」的路径：文件里是 64 位十六进制（32 字节），
# 用来给库里的供应商密钥做 AES-256-GCM 加解密。生成与保管见部署手册。
# 这个文件不要提交，也不要和数据库备份放在一起太久——它一丢，已保存的密钥就解不开，要重新填。
# MODEL_CONFIG_KEY_FILE=/absolute/private/secrets/model_config_key

# llama.cpp 地址由实例管理员在页面中保存。仅允许连接这些精确 origin，
# 不要配置公网地址。
# LOCAL_LLM_ALLOWED_ORIGINS=http://llama:8080,http://host.docker.internal:8080,http://127.0.0.1:8080
# LOCAL_LLM_PROBE_TIMEOUT_MS=3000
# LOCAL_LLM_CHAT_PROBE_TIMEOUT_MS=30000

# Product-owner-approved crisis resources only. Keep unset to use the safe,
# number-free default. Value is a JSON array of {type,label,guidance}.
# CRISIS_RESOURCES_JSON=

# 联网搜索开关（web_search 工具，聊天/工作模式可用，复用内置 Chromium）
# SEARCH_ENABLED=false
# 可选：自托管 SearXNG（开源元搜索，compose.dev.yaml 的 searxng 服务）做搜索后端，JSON API 免解析 HTML；
# 不配或它不可用时回退必应抓取。本机开发：docker compose -f compose.dev.yaml up -d searxng
# SEARCH_SEARXNG_URL=http://127.0.0.1:8888

# 工作模式扩展（仅工作模式生效；默认全关。插件/MCP 可执行本机任意代码，与 bash_run 同级信任，确认后再开）
# SKILLS_ENABLED=true   # SKILL.md 目录技能，use_skill 按需加载；默认目录 apps/api/data/skills，SKILLS_DIR 覆盖；改/加文件需重启
# PLUGINS_ENABLED=true  # JS 插件目录，默认导出 { name, description, run }；默认 apps/api/data/plugins，PLUGINS_DIR 覆盖
# MCP stdio server（MCP_ENABLED=true 才生效）：server 是本机任意代码，与 bash_run 同级信任，配了才接进工具目录。
# MCP_SERVERS_JSON 形如 {"fs":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","D:/docs"]}}；
# 工具名 = server 键名 + 工具名；只读工具（带 readOnlyHint 或配置里 readOnly:true）免确认卡，其余走确认卡。
# 热榜查证（NewsNow，compose.dev.yaml 的 newsnow 服务）：
# MCP_SERVERS_JSON={"newsnow":{"command":"npx","args":["-y","newsnow-mcp-server"],"env":{"BASE_URL":"http://127.0.0.1:4444"},"readOnly":true}}
# 语音转文字（本机 FunASR sidecar，tools/asr-server，模型 iic/SenseVoiceSmall 来自 ModelScope）：不配置则语音输入诚实报不可用
# ASR_BASE_URL=http://127.0.0.1:5005

# 装扮里的收藏（/api/collection）：照片与缩略图存 COLLECTION_DIR（默认 apps/api/data/collection，在 API 数据卷里）。
# 旧的 3D 衣柜与化妆间模拟预览已于 2026-09-21 下线，IMAGE_TO_3D_* 不再使用。
# COLLECTION_DIR=
# 花草图鉴（/api/garden）：收进图鉴的照片与缩略图存 GARDEN_DIR（默认 apps/api/data/garden，同在 API 数据卷里）。
# 识别用的就是聊天那个模型槽（GATEWAY_QWEN_MODEL 要是视觉模型），识别时的照片不落盘。
# GARDEN_DIR=
# 花草图鉴的本机名录与毒性库（路线图 C27）：scripts/build-plant-reference.mjs 建成的 JSON，默认仓库根目录 plant-data/plant-reference.json。
# 来源条款不许再分发，文件不进仓库；没有这个文件就不核，页面照旧只有模型的说法。
# PLANT_REFERENCE_FILE=

# 记忆向量是独立能力；未完整配置时仅使用关键词检索。不会套用聊天模型。书架选章（书籍技能）也用它补上关键词漏掉的说法。
# 本机开发推荐 tools/embedding-server（ModelScope 的 Qwen/Qwen3-Embedding-0.6B，只在本机算、不花钱）：
#   MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:5006/v1、MEMORY_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B、MEMORY_EMBEDDING_DIMENSIONS=1024，
#   令牌文件与向量服务的 EMBEDDING_API_KEY_FILE 是同一个；换模型后重建书架索引（pnpm --filter cyber-sister-server books:index -- --live）。
# MEMORY_EMBEDDING_BASE_URL=https://approved-embedding-provider.example/v1
# MEMORY_EMBEDDING_MODEL=approved-embedding-model
# MEMORY_EMBEDDING_DIMENSIONS=1024
# MEMORY_EMBEDDING_API_KEY_FILE=/run/secrets/memory_embedding_api_key
# 工作文件分析：先构建 apps/api/work-runtime 镜像，代码仅在无网络容器中执行。
WORK_CODE_ENABLED=false
WORK_CODE_IMAGE=amie-work-python:20260915
WORK_NATIVE_TOOLS=false
# 显式提交的后台任务持久化到 PostgreSQL；需先应用 work_tasks 迁移。
WORK_TASKS_ENABLED=false
## 公网服务器始终使用 web；local 仅供绑定回环地址的本地工作运行时。
APP_DISTRIBUTION=web
# 动态网页操作：先构建 work-browser-runtime；匿名会话，不开放登录与提交写入。
WORK_BROWSER_ENABLED=false
WORK_BROWSER_WRITES_ENABLED=false
## RunningHub 自建开源工作流：需要先部署迁移，并启用后台任务。
## Key 仅保存在服务器文件中，不要发到聊天或前端。文件路径由部署者设置。
RUNNINGHUB_ENABLED=false
RUNNINGHUB_API_KEY_FILE=
WORK_BROWSER_IMAGE=amie-work-browser:20260915
