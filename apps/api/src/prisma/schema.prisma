// 生产环境使用PostgreSQL，开发环境可使用Docker PostgreSQL或本地安装

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String    @id @default(uuid())
  phone                       String    @unique
  nickname                    String?
  avatarUrl                   String?   @map("avatar_url")
  persona                     String    @default("gentle")
  externalLlmConsent          Boolean?  @map("external_llm_consent")
  externalLlmConsentVersion   String?   @map("external_llm_consent_version")
  externalLlmConsentUpdatedAt DateTime? @map("external_llm_consent_updated_at")
  isVip                       Boolean   @default(false) @map("is_vip")
  vipExpireAt                 DateTime? @map("vip_expire_at")
  birthDate                   DateTime? @map("birth_date")
  roleName                    String?   @map("role_name")
  roleSetting                 String?   @map("role_setting")
  careEnabled                 Boolean   @default(true) @map("care_enabled") // 「她来想你」主动关怀总开关（真实生效）
  memoryEpoch                 Int       @default(0) @map("memory_epoch")
  companionState              Json?     @map("companion_state")
  companionRevision           Int       @default(0) @map("companion_revision")
  plansMigratedAt             DateTime? @map("plans_migrated_at") // 日程/倒数日/习惯/旧提醒已迁为安排的时间（迁移幂等标记）
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  conversations     Conversation[]
  memories          Memory[]
  todos             Todo[]
  countdowns        Countdown[]
  periodRecords     PeriodRecord[]
  reminders         Reminder[]
  diaryEntries      DiaryEntry[]
  habits            Habit[]
  crisisLogs        CrisisLog[]
  books             Book[]
  readingNotes      ReadingNote[]
  studySessions     StudySession[]
  refreshTokens     RefreshToken[]
  derivedInsights   DerivedInsight[]
  makeupPresets     MakeupPreset[]
  wardrobeItems     WardrobeItem[]
  memoryEdges       MemoryEdge[]
  careDismissals    CareDismissal[]
  letters           Letter[]
  scheduledReminders ScheduledReminder[]
  memoryIndexJobs MemoryIndexJob[]
  workArtifacts WorkArtifact[]
  workTasks WorkTask[]

  @@map("users")
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  mode      String   @default("chat") // 只有一种对话，新建恒为 chat；work 只是历史值（网页版隐藏）
  archivedAt DateTime? @map("archived_at")
  // 滚动摘要：summary 覆盖 createdAt <= summaryUpToAt 的消息；装配上下文时以 system 注入
  summary       String?   @db.Text
  summaryUpToAt DateTime? @map("summary_up_to_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  workArtifacts WorkArtifact[]
  workTasks WorkTask[]

  @@index([userId])
  @@index([userId, archivedAt, updatedAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  emotion        String?
  source         String?
  toolRuns       Json?    @map("tool_runs")
  companionExperience Json? @map("companion_experience")
  imageExt       String?  @map("image_ext") // .jpg/.png/.webp；存在即 data/chat-images/<userId>/<messageId><ext> 有文件
  importance     Int      @default(3)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workArtifacts WorkArtifact[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model WorkTask {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  conversationId  String   @map("conversation_id")
  requestKey      String   @map("request_key")
  requestHash     String   @map("request_hash")
  content         String   @db.Text
  attachments     Json
  status          String   @default("queued")
  checkpoint      Json?
  progress        Json     @default("[]")
  leaseToken      String?  @map("lease_token")
  leaseExpiresAt  DateTime? @map("lease_expires_at")
  attempts        Int      @default(0)
  errorCode       String?  @map("error_code")
  userMessageId   String?  @map("user_message_id")
  aiMessageId     String?  @map("ai_message_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  completedAt     DateTime? @map("completed_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actions      WorkAction[]

  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("work_tasks")
}

model WorkAction {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  leaseToken   String   @map("lease_token")
  step         Int
  purpose      String
  method       String
  url          String
  contentType  String   @map("content_type")
  body         String   @db.Text
  requestHash  String   @map("request_hash")
  status       String   @default("pending")
  expiresAt    DateTime @map("expires_at")
  decidedAt    DateTime? @map("decided_at")
  submittedAt  DateTime? @map("submitted_at")
  completedAt  DateTime? @map("completed_at")
  httpStatus   Int?     @map("http_status")
  provider     String?
  providerTaskId String? @map("provider_task_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@map("work_actions")
}

model WorkArtifact {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  conversationId String   @map("conversation_id")
  messageId      String   @map("message_id")
  title          String
  format         String
  content        String   @db.Text
  encoding       String   @default("utf8")
  origin         String   @default("generated")
  sizeBytes      Int      @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, conversationId, createdAt])
  @@map("work_artifacts")
}

model Memory {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  type       String // episodic | semantic | procedural
  content    String
  entities   String? // JSON字符串存储
  importance Int       @default(5)
  tags       String? // JSON数组字符串存储
  embedding  Float[] // 语义向量投影；可重建，失败留空（Prisma 不支持可选列表，NULL 读取即 []）
  embeddingModel String? @map("embedding_model")
  origin     String   @default("manual") // manual | suggestion | promoted；定典后不可改
  sourceRef  String?  @map("source_ref") // suggestion→用户消息 id；promoted→DerivedInsight id
  revision   Int      @default(1)
  sources    Json     @default("[]")
  portableId String   @default(uuid()) @map("portable_id")
  importedAt DateTime? @map("imported_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  edgesFrom MemoryEdge[] @relation("edgeFrom")
  edgesTo   MemoryEdge[] @relation("edgeTo")
  revisions MemoryRevision[]
  projection MemoryProjection?

  @@index([userId])
  @@index([userId, importance, createdAt])
  @@unique([userId, portableId])
  @@map("memories")
}

model MemoryEdge {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  fromMemoryId String   @map("from_memory_id")
  toMemoryId   String   @map("to_memory_id")
  relation     String // similar | related | contradicts
  confidence   String   @default("medium") // low | medium | high
  status       String   @default("derived") // derived | canonical | needs_review | dismissed
  revision     Int      @default(1)
  fromRevision Int     @default(1) @map("from_revision")
  toRevision   Int     @default(1) @map("to_revision")
  decisions    Json    @default("[]")
  evidence     String? // JSON数组字符串：支撑片段，最多 2 条
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromMemory Memory @relation("edgeFrom", fields: [fromMemoryId], references: [id], onDelete: Cascade)
  toMemory   Memory @relation("edgeTo", fields: [toMemoryId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("memory_edges")
}

// 「她来想你」触点按日忽略记录：key = 规则:实体:本地日，同日同键幂等
model CareDismissal {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("care_dismissals")
}


// 「她的信」：每周一封，由本周真实数据本地生成（不调用云端模型），幂等唯一于 用户+周起始
model Letter {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  weekStart DateTime @map("week_start") // 本地周周一，UTC 零点存储（同日记契约）
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("letters")
}
/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model Todo {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  content   String
  dueDate   DateTime? @map("due_date")
  // 'HH:mm' 本地时间，无日期语义，仅随 dueDate 展示与排序；设置时间必须先有日期
  dueTime   String?   @map("due_time")
  isDone    Boolean   @default(false) @map("is_done")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("todos")
}

/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model Countdown {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  title      String
  targetDate DateTime @map("target_date")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("countdowns")
}

model PeriodRecord {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  cycleDays Int       @default(28) @map("cycle_days")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("period_records")
}

/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model Reminder {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String // water | sleep | period
  time      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("reminders")
}

model CrisisLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  triggerMsg String?  @map("trigger_msg")
  level      String?
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("crisis_logs")
}

// ============ 认证相关 ============

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") // SHA-256 hash of the refresh token
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}


model DiaryEntry {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  // 日期契约同经期/倒数日：'yyyy-MM-dd' 按 UTC 零点存储，前端按本地日历日解析比较
  day             DateTime
  mood            String // happy | neutral | sad | angry | anxious（与聊天情绪同词表）
  content         String
  aiComment       String?  @map("ai_comment")
  aiCommentSource String?  @map("ai_comment_source")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
  @@map("diary_entries")
}

/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model Habit {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String
  icon       String // 固定图标集键（droplet | moon | dumbbell | book | flower | pen）
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins  HabitCheckin[]

  @@index([userId])
  @@map("habits")
}

/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model HabitCheckin {
  id        String   @id @default(uuid())
  habitId   String   @map("habit_id")
  userId    String   @map("user_id")
  // 本地日历日（同日记契约，UTC 零点存储）
  day       DateTime
  createdAt DateTime @default(now()) @map("created_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, day])
  @@index([userId, day])
  @@map("habit_checkins")
}

model Book {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  title       String
  author      String?
  status      String        @default("reading") // want | reading | finished
  totalPages  Int?          @map("total_pages")
  currentPage Int           @default(0) @map("current_page")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes ReadingNote[]

  @@index([userId])
  @@map("books")
}

model ReadingNote {
  id              String   @id @default(uuid())
  bookId          String   @map("book_id")
  userId          String   @map("user_id")
  page            Int?
  content         String
  aiComment       String?  @map("ai_comment")
  aiCommentSource String?  @map("ai_comment_source")
  createdAt       DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId, createdAt])
  @@map("reading_notes")
}

/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model StudySession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  subject         String?
  plannedMinutes  Int      @map("planned_minutes")
  actualMinutes   Int      @map("actual_minutes")
  note            String?
  aiComment       String?  @map("ai_comment")
  aiCommentSource String?  @map("ai_comment_source")
  startedAt       DateTime @map("started_at")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
