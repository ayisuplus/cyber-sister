// 生产环境使用PostgreSQL，开发环境可使用Docker PostgreSQL或本地安装

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String    @id @default(uuid())
  phone                       String    @unique
  nickname                    String?
  avatarUrl                   String?   @map("avatar_url")
  persona                     String    @default("gentle")
  externalLlmConsent          Boolean?  @map("external_llm_consent")
  externalLlmConsentVersion   String?   @map("external_llm_consent_version")
  externalLlmConsentUpdatedAt DateTime? @map("external_llm_consent_updated_at")
  isVip                       Boolean   @default(false) @map("is_vip")
  vipExpireAt                 DateTime? @map("vip_expire_at")
  birthDate                   DateTime? @map("birth_date")
  roleName                    String?   @map("role_name")
  roleSetting                 String?   @map("role_setting")
  careEnabled                 Boolean   @default(true) @map("care_enabled") // 「她来想你」主动关怀总开关（真实生效）
  memoryEpoch                 Int       @default(0) @map("memory_epoch")
  companionState              Json?     @map("companion_state")
  companionRevision           Int       @default(0) @map("companion_revision")
  plansMigratedAt             DateTime? @map("plans_migrated_at") // 日程/倒数日/习惯/旧提醒已迁为安排的时间（迁移幂等标记）
  periodConsentAt             DateTime? @map("period_consent_at") // 经期记录单独同意时间（敏感个人信息）；撤回置空
  periodToneAt                DateTime? @map("period_tone_at") // 「聊天时让她顾及你的周期」的单独同意时间；撤回记录同意时一并置空
  letterFreqDays              Int?      @map("letter_freq_days") // 「她的来信」频率（3 或 7 天一封）；空 = 不写信
  citeBooks                   Boolean   @default(false) @map("cite_books") // 「回答里提到书」：翻到书时回答里可以提书名；默认不提
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  conversations     Conversation[]
  memories          Memory[]
  todos             Todo[]
  countdowns        Countdown[]
  periodRecords     PeriodRecord[]
  reminders         Reminder[]
  diaryEntries      DiaryEntry[]
  habits            Habit[]
  crisisLogs        CrisisLog[]
  books             Book[]
  bookPassages      BookPassage[]
  readingNotes      ReadingNote[]
  studySessions     StudySession[]
  refreshTokens     RefreshToken[]
  makeupPresets     MakeupPreset[] // 旧化妆间滑杆预设：2026-09-21 起只读，仅随导出保留
  wardrobeItems     WardrobeItem[] // 旧 3D 衣柜单品：2026-09-21 起只读，仅随导出保留
  collectionItems   CollectionItem[]
  plantEntries      PlantEntry[]
  careDismissals    CareDismissal[]
  letters           Letter[]
  scheduledReminders ScheduledReminder[]
  memoryIndexJobs MemoryIndexJob[]
  workArtifacts WorkArtifact[]
  workTasks WorkTask[]
  localBridges       LocalBridge[]
  inferences         Inference[]
  embeddings         Embedding[]

  @@map("users")
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  mode      String   @default("chat") // 只有一种对话，新建恒为 chat；work 只是历史值（网页版隐藏）
  archivedAt DateTime? @map("archived_at")
  // 滚动摘要：summary 覆盖 createdAt <= summaryUpToAt 的消息；装配上下文时以 system 注入
  summary       String?   @db.Text
  summaryUpToAt DateTime? @map("summary_up_to_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  workArtifacts WorkArtifact[]
  workTasks WorkTask[]

  @@index([userId])
  @@index([userId, archivedAt, updatedAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  emotion        String?
  source         String?
  toolRuns       Json?    @map("tool_runs")
  companionExperience Json? @map("companion_experience")
  bookNotes      Json?    @map("book_notes") // 她写这一段时翻过的书（页边铅笔批注）；没翻书为 NULL
  imageExt       String?  @map("image_ext") // .jpg/.png/.webp；存在即 data/chat-images/<userId>/<messageId><ext> 有文件
  importance     Int      @default(3)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workArtifacts WorkArtifact[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model WorkTask {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  conversationId  String   @map("conversation_id")
  requestKey      String   @map("request_key")
  requestHash     String   @map("request_hash")
  content         String   @db.Text
  attachments     Json
  status          String   @default("queued")
  checkpoint      Json?
  progress        Json     @default("[]")
  leaseToken      String?  @map("lease_token")
  leaseExpiresAt  DateTime? @map("lease_expires_at")
  attempts        Int      @default(0)
  errorCode       String?  @map("error_code")
  userMessageId   String?  @map("user_message_id")
  aiMessageId     String?  @map("ai_message_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  completedAt     DateTime? @map("completed_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actions      WorkAction[]

  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("work_tasks")
}

model WorkAction {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  leaseToken   String   @map("lease_token")
  step         Int
  purpose      String
  method       String
  url          String
  contentType  String   @map("content_type")
  body         String   @db.Text
  requestHash  String   @map("request_hash")
  status       String   @default("pending")
  expiresAt    DateTime @map("expires_at")
  decidedAt    DateTime? @map("decided_at")
  submittedAt  DateTime? @map("submitted_at")
  completedAt  DateTime? @map("completed_at")
  httpStatus   Int?     @map("http_status")
  provider     String?
  providerTaskId String? @map("provider_task_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@map("work_actions")
}

model WorkArtifact {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  conversationId String   @map("conversation_id")
  messageId      String   @map("message_id")
  title          String
  format         String
  content        String   @db.Text
  encoding       String   @default("utf8")
  origin         String   @default("generated")
  sizeBytes      Int      @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, conversationId, createdAt])
  @@map("work_artifacts")
}

model Memory {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  type       String // episodic | semantic | procedural
  content    String
  importance Int       @default(5)
  tags       String? // JSON数组字符串存储
  origin     String   @default("manual") // manual | suggestion | promoted；定典后不可改
  sourceRef  String?  @map("source_ref") // suggestion→用户消息 id；来源（她的原话、采纳的来信建议等）放 sources 数组
  revision   Int      @default(1)
  sources    Json     @default("[]")
  portableId String   @default(uuid()) @map("portable_id")
  importedAt DateTime? @map("imported_at")
  expiresAt  DateTime? @map("expires_at")
  /// 「放在心上」：每轮都带给她，不参与注意力竞争；每个用户最多 5 条（服务端保证）
  pinned     Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions MemoryRevision[]

  @@index([userId])
  @@index([userId, importance, createdAt])
  @@index([userId, pinned])
  @@unique([userId, portableId])
  @@map("memories")
}

// 「她来想你」触点按日忽略记录：key = 规则:实体:本地日，同日同键幂等
model CareDismissal {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("care_dismissals")
}


// 「她的来信」：按用户设定的频率（3/7 天）由服务器端根据记忆书写，幂等唯一于 用户+周期起点
model Letter {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  periodStart DateTime  @map("period_start") // 周期起点（本地日，UTC 零点存储，同日记/经期契约）
  freqDays    Int       @map("freq_days") // 这封信按几天一封的频率生成（3 或 7）
  content     String
  suggestions Json      @default("[]") // 信里的建议（edit_memory/delete_memory/plan），decided 由用户动作决定
  readAt      DateTime? @map("read_at") // 用户看过这封信的时间
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@map("letters")
}
/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model Todo {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  content   String
  dueDate   DateTime? @map("due_date")
  // 'HH:mm' 本地时间，无日期语义，仅随 dueDate 展示与排序；设置时间必须先有日期
  dueTime   String?   @map("due_time")
  isDone    Boolean   @default(false) @map("is_done")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("todos")
}

/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model Countdown {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  title      String
  targetDate DateTime @map("target_date")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("countdowns")
}

model PeriodRecord {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  cycleDays Int       @default(28) @map("cycle_days")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("period_records")
}

/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model Reminder {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String // water | sleep | period
  time      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("reminders")
}

model CrisisLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  triggerMsg String?  @map("trigger_msg")
  level      String?
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("crisis_logs")
}

// ============ 认证相关 ============

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") // SHA-256 hash of the refresh token
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}


model DiaryEntry {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  // 日期契约同经期/倒数日：'yyyy-MM-dd' 按 UTC 零点存储，前端按本地日历日解析比较
  day             DateTime
  mood            String // happy | neutral | sad | angry | anxious（与聊天情绪同词表）
  content         String
  aiComment       String?  @map("ai_comment")
  aiCommentSource String?  @map("ai_comment_source")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
  @@map("diary_entries")
}

/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model Habit {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String
  icon       String // 固定图标集键（droplet | moon | dumbbell | book | flower | pen）
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins  HabitCheckin[]

  @@index([userId])
  @@map("habits")
}

/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model HabitCheckin {
  id        String   @id @default(uuid())
  habitId   String   @map("habit_id")
  userId    String   @map("user_id")
  // 本地日历日（同日记契约，UTC 零点存储）
  day       DateTime
  createdAt DateTime @default(now()) @map("created_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, day])
  @@index([userId, day])
  @@map("habit_checkins")
}

model Book {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  title       String
  author      String?
  status      String        @default("reading") // want | reading | finished
  totalPages  Int?          @map("total_pages")
  currentPage Int           @default(0) @map("current_page")
  /// 书本身存在用户自己的浏览器里，服务端只记元数据；format 为空表示聊天里随口记下的纸书
  format      String?       // epub | txt
  fileName    String?       @map("file_name")
  /// 前端给的进度串（"<spine 序号>:<字符偏移>"），服务端只存不解析
  locator     String?
  percent     Int?          // 0-100，显示用
  /// 她选了「让她聊天时也能翻」才上传分段：null = 只在这台设备；indexing | ready | failed
  serverIndex   String?     @map("server_index")
  /// 算段落向量时的身份（供应商哈希、模型、维度、规则版本）；和这一轮的查询向量对得上才翻
  indexIdentity Json?       @map("index_identity")
  indexedAt     DateTime?   @map("indexed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes    ReadingNote[]
  passages BookPassage[]

  @@index([userId])
  @@map("books")
}

/// 她上传的书切成的段（约 600 字，相邻重叠约 80 字），聊天时按向量翻；撤回上传或删书即删
model BookPassage {
  id           String   @id @default(uuid())
  bookId       String   @map("book_id")
  userId       String   @map("user_id")
  seq          Int
  chapterIndex Int      @map("chapter_index")
  chapter      String?
  /// 与阅读器同格式的位置串（"<章序>:<字符偏移>"），批注里「翻到这一段」用
  locator      String
  content      String
  createdAt    DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId, seq])
  @@map("book_passages")
}

model ReadingNote {
  id              String   @id @default(uuid())
  bookId          String   @map("book_id")
  userId          String   @map("user_id")
  page            Int?
  content         String
  /// 记这一笔时选中的那段原文与位置，回头能翻回去
  quote           String?
  locator         String?
  aiComment       String?  @map("ai_comment")
  aiCommentSource String?  @map("ai_comment_source")
  createdAt       DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId, createdAt])
  @@map("reading_notes")
}

/// 已停用（2026-09 功能收拢）：由「安排」（ScheduledReminder）替代，只读保留供导出与迁移，不再写入。
model StudySession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  subject         String?
  plannedMinutes  Int      @map("planned_minutes")
  actualMinutes   Int      @map("actual_minutes")
  note            String?
  aiComment       String?  @map("ai_comment")
  aiCommentSource String?  @map("ai_comment_source")
  startedAt       DateTime @map("started_at")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("study_sessions")
}

// 正式记忆的确认历史；业务编辑只追加，删除记忆时级联清除。
model MemoryRevision {
  id          String   @id @default(uuid())
  memoryId    String   @map("memory_id")
  revision    Int
  type        String
  content     String
  importance  Int
  tags        String?
  expiresAt   DateTime? @map("expires_at")
  origin      String
  sources     Json     @default("[]")
  action      String // create | edit | import | baseline | accept_suggestion
  // 来源链（路线图 C23）：这一版是采纳了哪封信的哪条建议写下的 { letterId, index, kind, inferenceIds }
  proposal    Json?
  restoredFrom Int?   @map("restored_from")
  imported    Boolean  @default(false)
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  memory      Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([memoryId, revision])
  @@map("memory_revisions")
}

model MemoryIndexJob {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  mode        String // repair | rebuild
  status      String   @default("queued") // queued | running | completed | cancelled | interrupted | failed
  total       Int      @default(0)
  processed   Int      @default(0)
  embedded    Int      @default(0)
  skipped     Int      @default(0)
  failed      Int      @default(0)
  errorCode   String?  @map("error_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("memory_index_jobs")
}

model MakeupPreset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  smooth    Int
  whiten    Int
  slim      Int
  eye       Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("makeup_presets")
}

model WardrobeItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  sourceExt String   @map("source_ext") // .jpg/.png/.webp
  modelExt  String   @map("model_ext") // 固定 .glb
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wardrobe_items")
}

/// 「安排」：日程、倒数日、提醒、每日打卡与交给她做的定时任务共用这一种模型。
model ScheduledReminder {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  content    String
  // 有指令 = 定时任务：到点跑 agent 回路执行并把产出写进投递；无指令 = 纯提醒
  instruction String?  @db.Text
  freq       String    @default("once") // once | daily | weekly | monthly | yearly
  time       String? // 'HH:mm' 本地时间
  fireAt     DateTime? @map("fire_at") // 一次性：具体触发时刻（UTC）；每年：锚点，取其月日
  weekdays   Int[] // 每周：0-6（getDay 约定），否则空数组
  monthDay   Int?     @map("month_day") // 每月：1-31
  nextFireAt DateTime @map("next_fire_at") // 预计算下次触发（UTC），支撑无 worker 轮询
  status     String   @default("active") // active | paused | done
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries ReminderDelivery[]

  @@index([userId, status, nextFireAt])
  @@map("scheduled_reminders")
}

model ReminderDelivery {
  id         String   @id @default(uuid())
  reminderId String   @map("reminder_id")
  fireAt     DateTime @map("fire_at") // 该次触发时刻（UTC），= 当时的 nextFireAt
  status     String   @default("pending") // pending | running (task claimed) | shown | dismissed | failed
  result     String?  @db.Text // 定时任务的执行产出（纯提醒恒为 null）
  createdAt  DateTime @default(now()) @map("created_at")

  reminder ScheduledReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, fireAt])
  @@map("reminder_deliveries")
}

/// 本机助手：用户电脑上主动外连的小程序，一行是一台电脑。连接码与令牌都只存哈希；
/// 连接码领取后清空，断开时清空令牌并记下 revokedAt。
model LocalBridge {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  name             String?
  pairingCodeHash  String?   @unique @map("pairing_code_hash")
  pairingExpiresAt DateTime? @map("pairing_expires_at")
  tokenHash        String?   @unique @map("token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSeenAt       DateTime? @map("last_seen_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("local_bridges")
}

/// 派生索引（路线图 C23）：记忆与她上传的书的段落，向量都在这一张表。只是派生物：可丢弃、可重算、不导出。
/// identityKey = 模型身份（地址哈希 + 模型 + 维度）+ 这类对象的规则版本（services/vectors/identity.js）；
/// subjectVersion 是算向量那段文字的 sha256，文字一改就对不上。向量写入前已归一化。
/// 对象可能是记忆或书段落，没法各挂外键：parentId 记记忆 id 或书 id，删记忆、删书、撤回上传时按它一并删掉。
/// 内置书的章节卡向量随代码提交在 skills/book-index.json，不进这张表。
model Embedding {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  subjectType    String   @map("subject_type") // memory | passage
  subjectId      String   @map("subject_id")
  parentId       String   @map("parent_id") // 记忆：它自己；段落：所属的书
  subjectVersion String   @map("subject_version")
  identityKey    String   @map("identity_key")
  dimensions     Int
  vector         Float[]
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subjectType, subjectId, identityKey])
  @@index([userId, subjectType, identityKey])
  @@index([subjectType, parentId])
  @@map("embeddings")
}

/// 她的组织层（路线图 C23，见 docs/architecture/非对称记忆架构.md）：她用你的记忆自行推断、自行整理的东西。
/// 永远不是记忆：聊天时标成「她自己的联想」、不当事实；进入根（memories）只能经来信建议、你点同意。
/// 依据的根被改就作废（stale），被删就连同引文删除；你在「她猜的」里删掉的只留去重键（vetoed），不再推出同一条。
model Inference {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  kind           String // relation | insight | followup
  content        String // 给她看的一句
  payload        Json      @default("{}") // relation: {fromMemoryId,toMemoryId,relation,confidence}；insight: {category,confidence}；followup: {about,ask}
  basis          Json      @default("[]") // 与 Memory.sources 同形：[{ type, id, revision?, quote, status }]
  basisMemoryIds String[]  @default([]) @map("basis_memory_ids")
  status         String    @default("active") // active | stale | vetoed | closed
  outcome        String? // closed 时：asked | accepted | declined
  letteredAt     DateTime? @map("lettered_at") // 进过哪封信（写信素材只取没进过信的）
  proposedIn     Json?     @map("proposed_in") // 变成来信建议时：{ letterId, index }
  dedupeKey      String    @map("dedupe_key")
  producedBy     String    @map("produced_by") // reflection:<时间> | import | migration
  dueOn          DateTime? @map("due_on") // 惦记的事哪天问（北京时间日历日，UTC 零点存储）
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, status, kind])
  @@index([userId, kind, dueOn])
  @@map("inferences")
}

/// 「装扮」里的收藏：衣柜与化妆间共用一张表。照片存在 data/collection/<userId>/，行内只记 imageExt。
model CollectionItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  shelf     String // wardrobe | makeup
  category  String? // 固定清单里的一项，见 collectionService
  name      String // ≤40 字
  note      String? // ≤300 字：色号、尺码、在哪买的
  status    String   @default("have") // want | have
  link      String? // 只收 http(s)；服务器从不打开它
  imageExt  String?  @map("image_ext") // 有照片时为 .jpg（另有 .thumb.jpg 缩略图）
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, shelf, createdAt])
  @@map("collection_items")
}

/// 花草图鉴（2026-09-26，路线图 C26）：她收进图鉴的一株花草。照片和收藏一样存在 API 数据卷里（data/garden/），不在数据库里；
/// 识别结果（候选、讲解、提醒）是收藏时从识别那一步带过来的，服务器再校验一遍；不识别、自己写名字也能收。
model PlantEntry {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  name           String // 中文名，≤40 字
  scientificName String?  @map("scientific_name") // 学名，≤80
  family         String? // 科，≤40
  status         String   @default("met") // met 路上遇见 | grow 我养的
  note           String? // ≤300 字：在哪遇见的、她的心情
  candidates     Json? // 识别时模型给的 1–3 个候选（名字、学名、科、像不像）
  explanation    Json? // 她的讲解：是什么、怎么认、花期、民间说法、想养的话
  caution        String? // 对人或猫狗有毒的提醒
  promptVersion  String?  @map("prompt_version") // 识别提示词版本，如 plant-id-v1
  identifiedBy   String?  @map("identified_by") // 识别用的模型
  imageExt       String?  @map("image_ext") // 有照片时为 .jpg（另有 .thumb.jpg 缩略图）
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("plant_entries")
}

/// 自定义模型供应商（2026-09-22）：实例管理员在应用里配置的多家 OpenAI 兼容服务，网关按 priority 依次切换。
/// name 是给人看的显示名，不参与网关装配；api_key_encrypted 是 AES-256-GCM 密文
/// （主密钥来自只读文件 MODEL_CONFIG_KEY_FILE），任何读接口只回 hasKey，绝不回显明文。
model ModelProvider {
  id              String   @id @default(uuid())
  name            String // 显示名，≤40 字
  baseUrl         String   @map("base_url") // 已经过 https / 无内嵌凭据 / 非内网 三项校验
  model           String // 模型名，原样交给供应商
  apiKeyEncrypted String?  @map("api_key_encrypted") // 没有 key 的本地端点留空；永远不存明文
  scenes          String   @default("chat") // chat / explain / work 的逗号分隔组合
  priority        Int      @default(100) // 小的先用；由管理接口按列表顺序写入
  enabled         Boolean  @default(true)
  updatedBy       String?  @map("updated_by") // 最后一次改动的管理员用户 id，只记 id
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@map("model_providers")
}
