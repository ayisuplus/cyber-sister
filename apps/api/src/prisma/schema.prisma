}

model DerivedInsight {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  kind             String // pattern | hypothesis | conflict | summary
  content          String
  evidence         String? // JSON数组字符串：支撑对话片段原文，最多 2 条
  confidence       String   @default("medium") // low | medium | high
  status           String   @default("active") // active | promoted | dismissed | resolved
  resolution       String? // 冲突厘清后的定稿文案（status=resolved 时写入）
  promotedMemoryId String?  @map("promoted_memory_id")
  revision         Int      @default(1)
  sources          Json     @default("[]")
  sourceMemoryIds  String[] @default([]) @map("source_memory_ids")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("derived_insights")
}

// 正式记忆的确认历史；业务编辑只追加，删除记忆时级联清除。
model MemoryRevision {
  id          String   @id @default(uuid())
  memoryId    String   @map("memory_id")
  revision    Int
  type        String
  content     String
  importance  Int
  tags        String?
  expiresAt   DateTime? @map("expires_at")
  origin      String
  sources     Json     @default("[]")
  action      String
  restoredFrom Int?   @map("restored_from")
  imported    Boolean  @default(false)
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  memory      Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([memoryId, revision])
  @@map("memory_revisions")
}

// 可替换的机器投影；旧 Memory.embedding 列只作迁移留存，不再参与检索。
model MemoryProjection {
  memoryId       String   @id @map("memory_id")
  memoryRevision Int      @map("memory_revision")
  provider       String
  model          String
  dimensions     Int
  ruleVersion    Int      @default(1) @map("rule_version")
  vector         Float[]
  updatedAt      DateTime @updatedAt @map("updated_at")
  memory         Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@map("memory_projections")
}

model MemoryIndexJob {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  mode        String // repair | rebuild
  status      String   @default("queued") // queued | running | completed | cancelled | interrupted | failed
  total       Int      @default(0)
  processed   Int      @default(0)
  embedded    Int      @default(0)
  skipped     Int      @default(0)
  failed      Int      @default(0)
  errorCode   String?  @map("error_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("memory_index_jobs")
}

model MakeupPreset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  smooth    Int
  whiten    Int
  slim      Int
  eye       Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("makeup_presets")
}

model WardrobeItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  sourceExt String   @map("source_ext") // .jpg/.png/.webp
  modelExt  String   @map("model_ext") // 固定 .glb
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wardrobe_items")
}

/// 「安排」：日程、倒数日、提醒、每日打卡与交给她做的定时任务共用这一种模型。
model ScheduledReminder {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  content    String
  // 有指令 = 定时任务：到点跑 agent 回路执行并把产出写进投递；无指令 = 纯提醒
  instruction String?  @db.Text
  freq       String    @default("once") // once | daily | weekly | monthly | yearly
  time       String? // 'HH:mm' 本地时间
  fireAt     DateTime? @map("fire_at") // 一次性：具体触发时刻（UTC）；每年：锚点，取其月日
  weekdays   Int[] // 每周：0-6（getDay 约定），否则空数组
  monthDay   Int?     @map("month_day") // 每月：1-31
  nextFireAt DateTime @map("next_fire_at") // 预计算下次触发（UTC），支撑无 worker 轮询
  status     String   @default("active") // active | paused | done
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries ReminderDelivery[]

  @@index([userId, status, nextFireAt])
  @@map("scheduled_reminders")
}

model ReminderDelivery {
  id         String   @id @default(uuid())
  reminderId String   @map("reminder_id")
  fireAt     DateTime @map("fire_at") // 该次触发时刻（UTC），= 当时的 nextFireAt
  status     String   @default("pending") // pending | running (task claimed) | shown | dismissed | failed
  result     String?  @db.Text // 定时任务的执行产出（纯提醒恒为 null）
  createdAt  DateTime @default(now()) @map("created_at")

  reminder ScheduledReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, fireAt])
  @@map("reminder_deliveries")
}
