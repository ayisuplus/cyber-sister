{
  "name": "cyber-sister-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "node --watch src/bootstrap.js",
    "start": "node src/bootstrap.js",
    "pretest": "pnpm db:generate",
    "test": "vitest run",
    "pretest:coverage": "pnpm db:generate",
    "test:coverage": "vitest run --coverage",
    "pretest:postgres": "pnpm db:generate",
    "test:postgres": "vitest run tests/integration/postgres.test.js tests/integration/memory-postgres.test.js tests/integration/companion-postgres.test.js tests/integration/work-tasks-postgres.test.js tests/integration/work-actions-postgres.test.js tests/integration/thread-postgres.test.js tests/integration/bridge-postgres.test.js",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:migrate:deploy": "node src/prisma/migrateDeploy.js",
    "db:migrate:plans": "node src/prisma/migratePlansToTasks.js",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "lint": "eslint src/ --max-warnings 146",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@cyber-sister/llm-gateway": "workspace:*",
    "schedule-logic": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "0.6.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ipaddr.js": "2.5.0",
    "jsonwebtoken": "^9.0.2",
    "linkedom": "0.18.13",
    "multer": "^2.3.0",
    "playwright-core": "^1.62.1",
    "prisma": "^5.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
