        { "category": "眼影盘", "shadeFamily": "裸粉 + 冷棕", "finishType": "哑光为主" },
        { "category": "腮红", "shadeFamily": "冷粉 / 玫瑰粉", "finishType": "哑光" },
        { "category": "口红", "shadeFamily": "玫瑰豆沙", "finishType": "雾面 / 缎面" }
