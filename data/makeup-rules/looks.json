  "looks": [
    {
      "id": "look_cool_water",
      "name": "清冷白开水妆",
      "scenario": "日常通勤",
      "suitableFor": ["oval", "round", "cool_fair", "neutral_fair", "cool_medium", "neutral_medium", "almond", "monolid"],
      "avoidFor": ["warm_deep", "warm_deep_dark"],
      "reason": "冷调清透,适合通勤、面试、见客户。妆感干净,不挑肤色偏冷或中性,让整个人透亮有精神。",
      "steps": [
        {
          "id": "cool_base",
          "title": "底妆",
          "area": "base",
          "order": 1,
          "instruction": "用美妆蛋少量多次按压粉底液,从脸颊中央向两侧推开,保留颧骨和鼻翼的薄透感。",
          "overlayZones": ["left_cheek", "right_cheek", "t_zone", "chin"],
          "brushDirection": "从内向外按压",
          "toolHint": "美妆蛋",
          "colorFamily": "冷调一白 / 中性一白",
          "warnings": ["不要厚涂,清透感是关键"]
        },
        {
          "id": "cool_concealer",
          "title": "遮瑕",
          "area": "concealer",
          "order": 2,
          "instruction": "在眼下三角区、痘印、鼻翼两侧点涂,用小号遮瑕刷轻拍至服帖。",
          "overlayZones": ["left_cheek", "right_cheek", "nose_sides"],
          "brushDirection": "点拍",
          "toolHint": "小号遮瑕刷 / 指腹",
          "colorFamily": "比粉底浅 0.5 号"
        },
        {
          "id": "cool_contour",
          "title": "修容",
          "area": "contour",
          "order": 3,
          "instruction": "在发际线、颧骨下方、下颌角轻扫灰棕色修容,营造自然阴影。",
          "overlayZones": ["forehead", "left_cheek", "right_cheek", "chin"],
          "brushDirection": "从耳下向内扫",
          "toolHint": "斜角修容刷",
          "colorFamily": "灰棕调",
          "warnings": ["修容要少量,白开水妆强调干净"]
        },
        {
          "id": "cool_highlight",
          "title": "高光",
          "area": "highlight",
          "order": 4,
          "instruction": "在颧骨最高点、鼻梁、眉骨轻点哑光高光,提亮但不夸张。",
          "overlayZones": ["nose_bridge", "left_highlight", "right_highlight", "t_zone"],
          "brushDirection": "点涂",
          "toolHint": "高光刷 / 指腹",
          "colorFamily": "哑光冷调高光"
        },
        {
          "id": "cool_brow",
          "title": "眉毛",
          "area": "brow",
          "order": 5,
          "instruction": "用灰棕色眉笔顺着眉形填补空缺,眉尾稍稍拉长,整体自然不锐利。",
          "overlayZones": ["left_brow", "right_brow"],
          "brushDirection": "顺着毛流方向",
          "toolHint": "灰棕色眉笔 + 眉刷",
          "colorFamily": "灰棕 / 冷棕"
        },
        {
          "id": "cool_eye",
          "title": "眼妆",
          "area": "eye",
          "order": 6,
          "instruction": "用裸粉色铺满上眼睑,冷棕色加深眼尾三角区,下眼睑后 1/3 轻轻带过。珠光只点内眼角。",
          "overlayZones": ["left_eyelid", "right_eyelid", "outer_corner_l", "outer_corner_r", "inner_corner_l", "inner_corner_r", "lower_lip"],
          "brushDirection": "从睫毛根部向上晕染",
          "toolHint": "中号眼影刷 + 细节刷",
          "colorFamily": "裸粉 / 冷棕",
          "warnings": ["肿泡眼避免眼皮中央铺珠光"]
        },
        {
          "id": "cool_eyeliner",
          "title": "眼线",
          "area": "eyeliner",
          "order": 7,
          "instruction": "画内眼线填满睫毛根部,外眼线只延伸到外眼角后 3mm 并微微下压,保持清冷感。",
          "overlayZones": ["left_eye", "right_eye", "outer_corner_l", "outer_corner_r"],
          "brushDirection": "沿睫毛根部画",
          "toolHint": "极细眼线笔",
          "colorFamily": "黑色 / 深棕"
        },
        {
          "id": "cool_blush",
          "title": "腮红",
          "area": "blush",
          "order": 8,
          "instruction": "在苹果肌轻扫冷粉或裸粉色,范围小而精准,不要往太阳穴拉。",
          "overlayZones": ["left_cheek", "right_cheek"],
          "brushDirection": "轻拍向上",
          "toolHint": "扇形腮红刷",
          "colorFamily": "冷粉 / 玫瑰粉"
        },
        {
          "id": "cool_lip",
          "title": "唇妆",
          "area": "lip",
          "order": 9,
          "instruction": "用玫瑰豆沙色薄涂一层,模糊唇线边缘,营造天生好气色感。",
          "overlayZones": ["upper_lip", "lower_lip", "lip_line"],
          "brushDirection": "从唇中央向嘴角",
          "toolHint": "唇刷 / 直接涂抹",
          "colorFamily": "玫瑰豆沙 / 冷调正红"
        }
      ],
      "productHints": [
